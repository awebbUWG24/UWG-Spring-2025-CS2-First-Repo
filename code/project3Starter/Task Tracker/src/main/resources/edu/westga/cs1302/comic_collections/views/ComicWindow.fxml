<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<DialogPane prefHeight="126.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.comic_collections.views.ComicDialog">
   <content>
      <AnchorPane prefHeight="156.0" prefWidth="360.0">
         <children>
            <TextField fx:id="comicNameField" layoutX="14.0" layoutY="48.0" />
            <Label layoutX="54.0" layoutY="23.0" text="Comic Name" />
            <Button fx:id="addComic" layoutX="50.0" layoutY="89.0" mnemonicParsing="false" text="Add Comic" />
            <TextField fx:id="issueNumberField" layoutX="209.0" layoutY="48.0" />
            <Label layoutX="247.0" layoutY="23.0" text="Issue Number" />
            <Button fx:id="cancel" layoutX="258.0" layoutY="89.0" mnemonicParsing="false" text="Cancel" />
         </children>
      </AnchorPane>
   </content>
</DialogPane>
